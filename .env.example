# Vurlo environment variables — Phase 0A foundation
# Copy to .env.local and fill in real values. Never commit .env.local.

# Public Supabase project URL (safe for client-side use)
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anonymous key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL used for callbacks / metadata (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import from client code, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Random string used to hash client IPs for rate limiting.
# Set a long random value in production (e.g. `openssl rand -hex 32`).
# If missing in production, a value derived from the service-role key is
# used and an error is logged; the public dev salt is never used there.
RATE_LIMIT_SALT=

# SERVER ONLY. Separate salt for the approximate unique-visitor hash
# (falls back to RATE_LIMIT_SALT). `openssl rand -hex 32`.
ANALYTICS_SALT=

# SERVER ONLY. Secret token for authenticating scheduled Vercel Crons
# (e.g. `openssl rand -hex 32`). Must match the Authorization header sent by Vercel Cron.
CRON_SECRET=

# SERVER ONLY. Optional webhook URL (Discord, Slack, or generic webhook)
# to receive instant notifications on server errors (logServerError).
ALERT_WEBHOOK_URL=

